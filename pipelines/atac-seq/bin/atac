#!/usr/bin/env bash
# =============================================================================
#  bin/atac —— 主程序（入口）
#
#  这里只做三件事，业务逻辑一律不写在这里：
#    1. 定位项目根目录，按文件名顺序加载 src/ 下所有模块
#    2. 解析命令行、初始化上下文、体检
#    3. 按 STAGES 顺序调用各阶段函数
#
#  想加一个阶段？在 src/ 里加一个文件（函数名 stage_xxx），在下面的
#  run_pipeline 里加一行，再在 20_context.sh 的 ALL_STAGES 里登记。
#  主程序之外不用改任何地方。
# =============================================================================
set -euo pipefail
set -E
# set -E 不能省：bash 默认不把 ERR trap 传给函数，而所有阶段都是函数
#
# 但 need / need_file / find_tool 这些"探测"函数本来就会返回非零（缺工具就是
# 要返回 1），返回值由调用方处理。它们的失败也会被 ERR trap 抓到——如果不过滤，
# --check 时每缺一个工具就刷一行假 FATAL，真正的问题反而被淹没。
_atac_on_err() {
  local stack=" ${FUNCNAME[*]} "
  case "$stack" in
    *" find_tool "*|*" need "*|*" need_file "*|*" need_var "*|\
*" first_existing "*|*" discover_genome "*|*" discover_bt2 "*|*" discover_one "*) return 0 ;;
  esac
  printf '\n[FATAL] %s 第 %s 行: %s\n' "${FUNCNAME[1]:-main}()" "$1" "$2" >&2
}
trap '_atac_on_err "$LINENO" "$BASH_COMMAND"' ERR

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SELF_DIR/.." && pwd)
export PROJECT_ROOT

# ---------------------------------------------------------------- 加载模块
# 文件名带序号，保证加载顺序：00 公共 → 10 CLI → 20 上下文 → 30+ 阶段
for _m in "$PROJECT_ROOT"/src/*.sh; do
  [[ -f "$_m" ]] || continue
  # shellcheck source=/dev/null
  source "$_m"
done
unset _m

# ---------------------------------------------------------------- 默认值
# config/atac.conf 用 ${VAR:=...}，所以环境变量里的值不会被覆盖
# shellcheck source=/dev/null
source "$PROJECT_ROOT/config/atac.conf"

# ---------------------------------------------------------------- 解析与初始化
parse_cli "$@"

if (( LIST_STAGES )); then
  list_stages
  exit 0
fi

init_context
header
preflight

if (( CHECK_ONLY )); then
  if (( MISSING_TOOLS > 0 )); then
    die "--check: 缺失 ${MISSING_TOOLS} 项（见上面的 WARN），未执行任何数据步骤"
  fi
  log "--check 通过，未执行任何数据步骤"
  exit 0
fi

# ---------------------------------------------------------------- 主流程
run_pipeline() {
  stage_enabled qc       && run_stage qc       stage_qc
  stage_enabled trim     && run_stage trim     stage_trim
  stage_enabled align    && run_stage align    stage_align
  stage_enabled bam      && run_stage bam      stage_bam
  stage_enabled frag     && run_stage frag     stage_frag
  stage_enabled peaks    && run_stage peaks    stage_peaks
  stage_enabled frip     && run_stage frip     stage_frip
  stage_enabled coverage && run_stage coverage stage_coverage
  stage_enabled annot    && run_stage annot    stage_annot
  stage_enabled motif    && run_stage motif    stage_motif
  stage_enabled atacqc   && run_stage atacqc   stage_atacqc
  stage_enabled igv      && run_stage igv      stage_igv
  stage_enabled report   && run_stage report   stage_report
  return 0
}

run_pipeline

# ---------------------------------------------------------------- 收尾
# .tmp 只放排序列的临时文件和一次性的中间文件，正常跑完就没用了。
# 排查问题时才需要它，所以默认清掉，--keep-tmp 保留。
if (( ! DRY_RUN )) && (( ! KEEP_TMP )) && [[ -d "$TMPD" && "$TMPD" == "$OUTDIR"/* ]]; then
  rm -rf "$TMPD"
fi

section "完成"
log "样本: $SAMPLE"
# 只跑了部分阶段时这些文件可能不存在，别指向空气
# （用 if 而不是 [[ ]] && log：后者会让整个脚本的退出码变成 1）
if [[ -s "$REP/summary.tsv" ]]; then log "汇总: $REP/summary.tsv"; fi
if [[ -s "$REP/report.html" ]]; then log "报告: $REP/report.html"; fi
if (( DRY_RUN )); then
  log "（dry-run 模式，未实际执行）"
elif [[ -s "$IGV/${SAMPLE}.igv_batch.txt" ]]; then
  log "IGV:  igv --batch $IGV/${SAMPLE}.igv_batch.txt"
fi
